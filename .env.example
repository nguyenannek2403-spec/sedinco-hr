# ==============================================================================
# SEDINCO HR - MONOREPO ENVIRONMENT TEMPLATE (.env.example)
# Copy backend variables to sedinco_backend/.env and frontend variables to
# zalo-miniapp-frontend/.env. NEVER commit real secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# A. FRONTEND (zalo-miniapp-frontend/.env) — PUBLIC / CLIENT-SAFE ONLY
# NEVER put CLOUDINARY_API_SECRET, JWT_SECRET, or DB credentials here!
# ------------------------------------------------------------------------------
# Base API URL of your deployed backend (any provider: Render, Railway, VPS, etc.)
VITE_API_URL=https://api.your-domain.example.com/api
VITE_ENABLE_CLIENT_ERROR_REPORTING=false
# Zalo Mini App CLI deploy config (optional for local dev)
APP_ID=
ZMP_TOKEN=

# ------------------------------------------------------------------------------
# B. BACKEND (sedinco_backend/.env) — SERVER ONLY
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173
ALLOW_RUNTIME_DDL=true
ENABLE_DIAGNOSTICS=false
ENABLE_CLIENT_ERROR_REPORTING=false

# Database (MySQL / TiDB Cloud / Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=sedinco_hr
DB_SSL=false
DB_SSL_CA=

# Cryptography & Auth (min 32 chars for production)
JWT_SECRET=replace_with_secure_random_jwt_secret_minimum_32_characters
QR_SECRET=replace_with_secure_random_qr_secret_minimum_32_characters
BCRYPT_WORKER_POOL_SIZE=2
DEVICE_BINDING_MODE=recording
LOCATION_MODE=WARN
REJECT_DOWNGRADE_TO_RAW=true

# Zalo & External APIs
ZALO_APP_ID=
ZALO_APP_SECRET=
CASSO_APP_ID=
CASSO_APP_SECRET=

# ==============================================================================
# SEDINCO HR - CLOUDINARY CONFIGURATION (BACKEND ONLY)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_API_KEY_NAME=sedinco
CLOUDINARY_FOLDER=sedinco-hr
CLOUDINARY_FOLDER_MODE=auto
CLOUDINARY_PRIVATE_DELIVERY_TYPE=authenticated

# ==============================================================================
# UPLOAD SECURITY
# ==============================================================================
UPLOAD_MAX_FILES_PER_REQUEST=5
UPLOAD_MAX_IMAGE_SIZE_BYTES=10485760
UPLOAD_MAX_DOCUMENT_SIZE_BYTES=15728640
UPLOAD_MAX_VIDEO_SIZE_BYTES=15728640
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
UPLOAD_RATE_LIMIT_MAX_REQUESTS=10
UPLOAD_DAILY_MAX_FILES_PER_USER=30
UPLOAD_DAILY_MAX_BYTES_PER_USER=104857600
UPLOAD_MAX_CONCURRENT_PER_USER=2
UPLOAD_GLOBAL_MAX_CONCURRENT=15
UPLOAD_DUPLICATE_CHECK_ENABLED=true

# ==============================================================================
# STORAGE MONITORING
# ==============================================================================
CLOUDINARY_STORAGE_BUDGET_BYTES=
CLOUDINARY_USAGE_WARNING_PERCENT=70
CLOUDINARY_USAGE_CRITICAL_PERCENT=85
CLOUDINARY_USAGE_BLOCK_PERCENT=95
CLOUDINARY_USAGE_SYNC_ENABLED=true

# ==============================================================================
# CLEANUP
# ==============================================================================
UPLOAD_ORPHAN_CLEANUP_ENABLED=true
UPLOAD_ORPHAN_RETENTION_HOURS=24
