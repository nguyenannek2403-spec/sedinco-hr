# =============================================================================
# Sedinco HR - Mẫu Biến Môi Trường Dành Cho Aiven Staging (.env.staging.example)
# TUYỆT ĐỐI KHÔNG ĐIỀN THÔNG TIN BÍ MẬT HAY TÀI KHOẢN THẬT VÀO FILE NÀY
# =============================================================================

# 1. Bắt buộc đặt NODE_ENV=staging để kích hoạt chốt chặn Aiven Staging
NODE_ENV=staging

# 2. Cấu hình máy chủ Aiven Staging (Host bắt buộc kết thúc bằng .aivencloud.com)
DB_HOST=your-mysql-staging-instance.aivencloud.com
DB_PORT=your-staging-port
DB_USER=your-staging-migration-username
DB_PASSWORD=your-staging-migration-password

# 3. Tên CSDL Staging: BẮT BUỘC chứa chuỗi "test" và KHỚP CHÍNH XÁC với ALLOW_DESTRUCTIVE_DB
DB_NAME=sedinco_hr_staging_test
ALLOW_DESTRUCTIVE_DB=sedinco_hr_staging_test

# 4. Kích hoạt SSL bảo mật khi kết nối Aiven
DB_SSL=true

# 5. Khóa bảo mật môi trường staging (Tối thiểu 32 ký tự)
JWT_SECRET=your-secure-jwt-secret-for-staging-environment-min-32-chars!
QR_SECRET=your-secure-qr-secret-for-staging-environment-min-32-chars!
