{
  "name": "sedinco-hr",
  "version": "1.0.0",
  "private": true,
  "description": "Sedinco HR - Monorepo Orchestrator",
  "scripts": {
    "start": "npm --prefix sedinco_backend start",
    "dev": "npm --prefix sedinco_backend run dev",
    "backend": "npm --prefix sedinco_backend start",
    "backend:dev": "npm --prefix sedinco_backend run dev",
    "miniapp": "npm --prefix zalo-miniapp-frontend start",
    "miniapp:deploy": "npm --prefix zalo-miniapp-frontend run deploy",
    "deploy": "npm --prefix zalo-miniapp-frontend run deploy",
    "login": "npm --prefix zalo-miniapp-frontend run login",
    "build": "cd zalo-miniapp-frontend && npm install && npx vite build && mkdir -p ../dist && cp -r www/* ../dist/ && rm -f ../dist/_redirects",
    "test": "npm --prefix sedinco_backend test"
  }
}
