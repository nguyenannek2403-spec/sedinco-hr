# Sedinco HR - Test Environment Example Configuration
# Sao chép tệp này thành .env.test và cung cấp thông tin CSDL kiểm thử cục bộ.
# CHỐT CHẶN AN TOÀN: DB_NAME bắt buộc phải chứa "test" và DB_HOST chỉ chấp nhận 127.0.0.1 / localhost.
NODE_ENV=test
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=test_db_user_placeholder
DB_PASSWORD=test_db_password_placeholder
DB_NAME=sedinco_hr_test
DB_SSL=false
JWT_SECRET=placeholder_test_jwt_secret_min_32_characters_long
