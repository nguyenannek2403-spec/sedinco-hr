# ==============================================================================
# SEDINCO HR - BACKEND ENVIRONMENT CONFIGURATION EXAMPLE
# COPY TO .env (NEVER COMMIT REAL SECRETS OR CREDENTIALS TO GIT)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME (Platform-agnostic: works on Render, Railway, VPS, Docker)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
# Number of reverse proxy hops (1 for Render/Nginx/Cloudflare, 'false' for local direct)
TRUST_PROXY=1
# Comma-separated allowed origins (Mini App Zalo, Web Admin, localhost dev)
CORS_ORIGIN=https://h5.zdn.vn,https://zapps.vn
ENABLE_DIAGNOSTICS=false
ENABLE_CLIENT_ERROR_REPORTING=false
ALLOW_RUNTIME_DDL=false

# ------------------------------------------------------------------------------
# 2. DATABASE (MySQL 8 / TiDB Cloud / Aiven)
# ------------------------------------------------------------------------------
DB_HOST=your-database-host.example.com
DB_PORT=4000
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=sedinco_hr
DB_SSL=true
# Optional SSL CA path or inline PEM when custom CA verification is required
DB_SSL_CA=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, SECURITY & CRYPTOGRAPHY (BACKEND ONLY)
# ------------------------------------------------------------------------------
# Minimum 32 random characters required in non-test environments
JWT_SECRET=replace_with_secure_random_jwt_secret_minimum_32_characters
QR_SECRET=replace_with_secure_random_qr_secret_minimum_32_characters
BCRYPT_WORKER_POOL_SIZE=2
DEVICE_BINDING_MODE=recording
LOCATION_MODE=WARN
REJECT_DOWNGRADE_TO_RAW=true

# ------------------------------------------------------------------------------
# 4. ZALO MINI APP INTEGRATION (BACKEND ONLY)
# ------------------------------------------------------------------------------
ZALO_APP_ID=
ZALO_APP_SECRET=

# ------------------------------------------------------------------------------
# 5. EXTERNAL INTEGRATIONS (OPTIONAL - BACKEND ONLY)
# ------------------------------------------------------------------------------
# Casso Bank Account Lookup API (Leave blank to disable auto-lookup gracefully)
CASSO_APP_ID=
CASSO_APP_SECRET=

# ==============================================================================
# 6. CLOUDINARY CENTRALIZED MEDIA STORAGE CONFIGURATION (BACKEND ONLY)
# NEVER expose CLOUDINARY_API_SECRET to frontend or Git!
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional label for key management auditing (SDK does not require it)
CLOUDINARY_API_KEY_NAME=sedinco
# Top-level root folder in Cloudinary (never created per-file)
CLOUDINARY_FOLDER=sedinco-hr
# auto | dynamic | fixed ('auto' uses asset_folder on Dynamic Folder Mode accounts)
CLOUDINARY_FOLDER_MODE=auto
# Delivery mode for private HR evidence/documents: authenticated | private | upload
CLOUDINARY_PRIVATE_DELIVERY_TYPE=authenticated

# ==============================================================================
# 7. UPLOAD SECURITY & ANTI-SPAM RATE LIMITING
# ==============================================================================
UPLOAD_MAX_FILES_PER_REQUEST=5
UPLOAD_MAX_IMAGE_SIZE_BYTES=10485760
UPLOAD_MAX_DOCUMENT_SIZE_BYTES=15728640
UPLOAD_MAX_VIDEO_SIZE_BYTES=15728640

UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
UPLOAD_RATE_LIMIT_MAX_REQUESTS=10

UPLOAD_DAILY_MAX_FILES_PER_USER=30
UPLOAD_DAILY_MAX_BYTES_PER_USER=104857600

UPLOAD_MAX_CONCURRENT_PER_USER=2
UPLOAD_GLOBAL_MAX_CONCURRENT=15
UPLOAD_DUPLICATE_CHECK_ENABLED=true

# ==============================================================================
# 8. STORAGE QUOTA MONITORING & BUDGET ALERTS
# ==============================================================================
# Leave blank to track usage without hardcoded budget limit, or set exact bytes
# (e.g. 26843545600 for 25 GB budget). Never guessed automatically.
CLOUDINARY_STORAGE_BUDGET_BYTES=
CLOUDINARY_USAGE_WARNING_PERCENT=70
CLOUDINARY_USAGE_CRITICAL_PERCENT=85
CLOUDINARY_USAGE_BLOCK_PERCENT=95

# Sync summary metrics via Cloudinary Admin Usage API once per 24h (cached in DB)
CLOUDINARY_USAGE_SYNC_ENABLED=true

# ==============================================================================
# 9. ORPHAN ASSET LIFECYCLE & SAFE CLEANUP
# ==============================================================================
UPLOAD_ORPHAN_CLEANUP_ENABLED=true
UPLOAD_ORPHAN_RETENTION_HOURS=24
