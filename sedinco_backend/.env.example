# ==========================================================
# CẤU HÌNH MÔI TRƯỜNG CHO SEDINCO HR BACKEND
# ==========================================================

# 1. Cấu hình chạy Localhost:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=sedinco_hr
# PORT=5001

# 2. Cấu hình khi Deploy lên RENDER (kết nối AIVEN MySQL):
# Sao chép các thông số từ Aiven Dashboard -> Service Overview -> Connection parameters:
DB_HOST=mysql-xxxxxxxx-your-project.a.aivencloud.com
DB_PORT=28123
DB_USER=avnadmin
DB_PASSWORD=your_aiven_db_password
DB_NAME=defaultdb
DB_SSL=true
PORT=5000
