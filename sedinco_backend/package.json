{
  "name": "sedinco_backend",
  "version": "1.0.0",
  "description": "Sedinco HR - Core REST API Backend (Node.js Express & MySQL)",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "npm": ">=10.0.0"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "NODE_ENV=test DB_NAME=${DB_NAME:-sedinco_hr_test} DB_SSL=false node --test --test-concurrency=1 --test-reporter=spec --test-force-exit __tests__/*.test.js"
  },
  "keywords": [
    "sedinco",
    "backend",
    "express",
    "mysql",
    "payroll",
    "attendance"
  ],
  "author": "Sedinco HR Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mysql2": "^3.24.5"
  }
}
